{
  "name": "silenttype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SilentType – Proof of Concept for silent (lip-only) command input via webcam. Research prototype.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-model": "bash scripts/fetch-model.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
